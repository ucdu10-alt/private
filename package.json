{
  "name": "fish-catch-data-video",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion template that turns a fish species' catch-data (timeseries + prefecture ranking) into 9:16 videos for Reels/TikTok/Shorts.",
  "scripts": {
    "start": "remotion studio",
    "build:timeseries": "remotion render Fish-Timeseries-sanma out/Fish-Timeseries-sanma.mp4",
    "build:ranking": "remotion render Fish-PrefectureRanking-sanma out/Fish-PrefectureRanking-sanma.mp4",
    "still": "remotion still",
    "upgrade": "remotion upgrade",
    "typecheck": "tsc -noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.520",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.520"
  },
  "devDependencies": {
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.1",
    "typescript": "5.6.3"
  }
}
